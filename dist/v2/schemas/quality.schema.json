{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.rivet.dev/rivet/v2/quality.schema.json",
  "title": "Agilno tracked quality policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providerRefs",
    "completionProfileRefs",
    "commandGates",
    "expectations",
    "evidence"
  ],
  "properties": {
    "contentScan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secrets": {
          "type": "boolean"
        },
        "unicode": {
          "enum": [
            "warn",
            "required",
            "off"
          ]
        },
        "maxFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "allowlist": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ruleId",
              "path",
              "reason"
            ],
            "properties": {
              "ruleId": {
                "enum": [
                  "private-key",
                  "github-token",
                  "npm-token",
                  "aws-access-key",
                  "unicode-bidi",
                  "unicode-mixed-identifier",
                  "type-suppression"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[/]$)[^\\\\*?\\[\\]{}\\u0000-\\u001f\\u007f]+$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              }
            }
          }
        },
        "shortcutRules": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ruleId",
              "paths",
              "reason"
            ],
            "properties": {
              "ruleId": {
                "const": "type-suppression"
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[/]$)[^\\\\*?\\[\\]{}\\u0000-\\u001f\\u007f]+$"
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "providerRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "completionProfileRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "commandGates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/commandGate"
      }
    },
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storybook",
        "playwright",
        "accessibility",
        "security",
        "visual"
      ],
      "properties": {
        "storybook": {
          "enum": [
            "optional",
            "required"
          ]
        },
        "playwright": {
          "enum": [
            "optional",
            "required"
          ]
        },
        "accessibility": {
          "enum": [
            "none",
            "wcag-a",
            "wcag-aa"
          ]
        },
        "security": {
          "enum": [
            "required",
            "not-applicable-with-approval"
          ]
        },
        "visual": {
          "enum": [
            "none",
            "automated",
            "human-baseline"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredTypes",
        "requireHumanBaseline",
        "requireHumanFinal"
      ],
      "properties": {
        "requiredTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceType"
          }
        },
        "requireHumanBaseline": {
          "type": "boolean"
        },
        "requireHumanFinal": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "maxRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "strictCoverage": {
          "type": "boolean"
        },
        "reviewers": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "paths",
              "required"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "verificationReuse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "reproducible": {
          "type": "boolean",
          "default": false
        },
        "dependencyRoots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)(?:\\.{1,2}|\\.git)(?:/|$))(?!.*//)(?!.*[/]$)[^\\\\\\u0000-\\u001f\\u007f*?\\[\\]{}]+$"
          }
        },
        "toolchainRoots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)(?:\\.{1,2}|\\.git)(?:/|$))(?!.*//)(?!.*[/]$)[^\\\\\\u0000-\\u001f\\u007f*?\\[\\]{}]+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "reproducible",
              "dependencyRoots",
              "toolchainRoots"
            ],
            "properties": {
              "reproducible": {
                "const": true
              },
              "dependencyRoots": {},
              "toolchainRoots": {}
            }
          }
        }
      ]
    },
    "verificationOutputs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.{1,2}|\\.[gG][iI][tT]|\\.[rR][iI][vV][eE][tT]-[dD][eE][pP][sS]|[nN][oO][dD][eE]_[mM][oO][dD][uU][lL][eE][sS])(?:/|$))(?!.*(?:^|/)(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.|/|$))(?!.*\\.(?:/|$))(?!.*//)(?!.*[/]$)[^\\\\:\\u0000-\\u0020\\u007f*?\\[\\]{}]+$"
      }
    },
    "verificationBatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "maxTasks": {
          "type": "integer",
          "minimum": 2,
          "maximum": 5,
          "default": 3
        },
        "waitMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000,
          "default": 2000
        },
        "maxIsolationTasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 2
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "evidenceType": {
      "enum": [
        "commit",
        "test",
        "journey",
        "screenshot",
        "report",
        "review",
        "human-approval",
        "external-update"
      ]
    },
    "commandGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "required"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "command": {
          "enum": [
            "build",
            "test",
            "lint",
            "typecheck",
            "dev",
            "check"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}
